<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="monynha_diagnosis_company_rule" model="ir.rule">
            <field name="name">Monynha Diagnosis Multi-Company</field>
            <field name="model_id" ref="model_monynha_lead_diagnosis"/>
            <field name="domain_force">[('lead_id.company_id', 'in', company_ids + [False])]</field>
        </record>

        <record id="monynha_diagnosis_personal_rule" model="ir.rule">
            <field name="name">Monynha Diagnosis: Own Leads</field>
            <field name="model_id" ref="model_monynha_lead_diagnosis"/>
            <field name="domain_force">['|', ('lead_id.user_id','=',user.id), ('lead_id.user_id','=',False)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        </record>

        <record id="monynha_diagnosis_all_leads_rule" model="ir.rule">
            <field name="name">Monynha Diagnosis: All Leads</field>
            <field name="model_id" ref="model_monynha_lead_diagnosis"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads'))]"/>
        </record>
    </data>
</odoo>
