<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_diagnosis_ready" model="mail.template">
        <field name="name">Monynha: diagnosis ready</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">O teu Project Signal está pronto</field>
        <field name="email_from">{{ object.company_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.email_from }}</field>
        <field name="body_html" type="html"><div style="font-family: Arial, sans-serif; line-height: 1.6;"><h2>O teu primeiro mapa já está pronto.</h2><p>Organizámos as respostas do discovery num Project Signal inicial para ajudar a orientar a próxima conversa.</p><p><a t-attf-href="{{ ctx.get('report_url') }}">Abrir Project Signal</a></p><p>Este diagnóstico é um ponto de partida — não uma decisão automática sobre o teu projeto.</p></div></field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
