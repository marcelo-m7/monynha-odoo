<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="monynha_lead_diagnosis_view_list" model="ir.ui.view">
        <field name="name">monynha.lead.diagnosis.list</field>
        <field name="model">monynha.lead.diagnosis</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="lead_id"/>
                <field name="state"/>
                <field name="provider"/>
                <field name="score"/>
                <field name="recommended_action"/>
                <field name="requested_at"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>
    <record id="monynha_lead_diagnosis_view_form" model="ir.ui.view">
        <field name="name">monynha.lead.diagnosis.form</field>
        <field name="model">monynha.lead.diagnosis</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_process" type="object" string="Process" class="btn-primary" invisible="state == 'completed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,processing,completed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group><field name="lead_id"/><field name="provider"/><field name="model_name"/></group>
                        <group><field name="score"/><field name="recommended_action"/><field name="public_url" widget="url"/><field name="completed_at"/></group>
                    </group>
                    <group string="Dimensions" col="4">
                        <field name="digital_maturity"/>
                        <field name="automation_potential"/>
                        <field name="process_clarity"/>
                        <field name="odoo_fit"/>
                    </group>
                    <group string="Summary"><field name="summary" nolabel="1"/></group>
                    <group string="Signals"><field name="signals" nolabel="1"/></group>
                    <group string="Technical" groups="base.group_system"><field name="raw_payload"/><field name="error_message"/></group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
