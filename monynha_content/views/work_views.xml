<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_monynha_work_list" model="ir.ui.view">
        <field name="name">monynha.work.list</field>
        <field name="model">monynha.work</field>
        <field name="arch" type="xml">
            <list string="Work" default_order="sequence,published_date desc,id desc">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="type"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <field name="featured" widget="boolean_toggle"/>
                <field name="is_published" widget="boolean_toggle"/>
                <field name="published_date"/>
                <field name="tag_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_monynha_work_search" model="ir.ui.view">
        <field name="name">monynha.work.search</field>
        <field name="model">monynha.work</field>
        <field name="arch" type="xml">
            <search string="Work">
                <field name="name"/>
                <field name="type"/>
                <field name="tag_ids"/>
                <field name="website_id" groups="website.group_multi_website"/>
                <filter name="published" string="Published" domain="[('is_published', '=', True)]"/>
                <filter name="unpublished" string="Unpublished" domain="[('is_published', '=', False)]"/>
                <filter name="featured" string="Featured" domain="[('featured', '=', True)]"/>
                <separator/>
                <filter name="type_project" string="Projects" domain="[('type', '=', 'project')]"/>
                <filter name="type_case" string="Cases" domain="[('type', '=', 'case')]"/>
                <filter name="type_lab" string="Labs" domain="[('type', '=', 'lab')]"/>
            </search>
        </field>
    </record>

    <record id="view_monynha_work_form" model="ir.ui.view">
        <field name="name">monynha.work.form</field>
        <field name="model">monynha.work</field>
        <field name="arch" type="xml">
            <form string="Work">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="open_website_url" type="object" class="oe_stat_button" icon="fa-globe" invisible="not id">
                            <div class="o_stat_info"><span class="o_stat_text">Go to Website</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Published" bg_color="text-bg-success" invisible="not is_published"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Work title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="website_id" groups="website.group_multi_website"/>
                            <field name="featured"/>
                            <field name="is_published" widget="boolean_toggle"/>
                            <field name="published_date"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="repository_url" widget="url"/>
                            <field name="external_url" widget="url"/>
                            <field name="website_url" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Content" name="content">
                            <field name="summary" placeholder="Short editorial summary"/>
                            <field name="body_html" widget="html" options="{'collaborative': true, 'resizable': true}"/>
                        </page>
                        <page string="SEO" name="seo">
                            <group>
                                <field name="website_meta_title"/>
                                <field name="website_meta_description"/>
                                <field name="website_meta_keywords"/>
                                <field name="website_meta_og_img"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_monynha_work_tag_list" model="ir.ui.view">
        <field name="name">monynha.work.tag.list</field>
        <field name="model">monynha.work.tag</field>
        <field name="arch" type="xml">
            <list string="Work Tags" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="view_monynha_work_tag_form" model="ir.ui.view">
        <field name="name">monynha.work.tag.form</field>
        <field name="model">monynha.work.tag</field>
        <field name="arch" type="xml">
            <form string="Work Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_monynha_work" model="ir.actions.act_window">
        <field name="name">Work</field>
        <field name="res_model">monynha.work</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_monynha_work_search"/>
    </record>

    <record id="action_monynha_work_tags" model="ir.actions.act_window">
        <field name="name">Work Tags</field>
        <field name="res_model">monynha.work.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_monynha_content" name="Monynha Content" parent="website.menu_website_configuration" sequence="70" groups="website.group_website_restricted_editor"/>
    <menuitem id="menu_monynha_work" name="Work" parent="menu_monynha_content" action="action_monynha_work" sequence="10"/>
    <menuitem id="menu_monynha_work_tags" name="Tags" parent="menu_monynha_content" action="action_monynha_work_tags" sequence="20"/>
</odoo>
